<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="SweetHome.App">
  <Application.Resources><ResourceDictionary>
    <Color x:Key="Primary">#8D4B55</Color><Color x:Key="Cream">#FFF8F2</Color><Color x:Key="Ink">#35292A</Color>
    <Style TargetType="Label"><Setter Property="TextColor" Value="{StaticResource Ink}" /></Style>
    <Style TargetType="Button"><Setter Property="BackgroundColor" Value="{StaticResource Primary}" /><Setter Property="TextColor" Value="White" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="14,10" /><Setter Property="FontAttributes" Value="Bold" /></Style>
  </ResourceDictionary></Application.Resources>
</Application>
